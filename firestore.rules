rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if caller is a verified administrator
    function isAdmin() {
      return isAuthenticated() && (
        ('email' in request.auth.token &&
         request.auth.token.email in ['hananemohamedinfo@gmail.com', 'admin@manchorati.com']) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // ===============================================================
    // Collections
    // ===============================================================

    // 1. Users collection (/users/{userId})
    // Supports authenticated users, guest users, and virtual community personas
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // 2. Usernames registry collection (/usernames/{username})
    // Required for username uniqueness, profile lookups, and username changes
    match /usernames/{username} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // 3. Community posts collection (/community_posts/{postId})
    // Supports posts, likes, counters, and background automation for both users and guests
    match /community_posts/{postId} {
      allow read: if true;
      allow create: if request.resource.data.authorId is string &&
                       request.resource.data.authorId.size() > 0 &&
                       request.resource.data.content is string &&
                       request.resource.data.content.size() > 0;
      allow update: if true;
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);

      // Subcollection: Comments (/community_posts/{postId}/comments/{commentId})
      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.resource.data.authorId is string &&
                         request.resource.data.authorId.size() > 0 &&
                         request.resource.data.content is string &&
                         request.resource.data.content.size() > 0;
        allow update: if true;
        allow delete: if true;
      }
    }

    // 4. Notifications collection (/notifications/{notifId})
    // Read by users/guests for their notifications; created by user actions & workers
    match /notifications/{notifId} {
      allow read: if true;
      allow create: if request.resource.data.recipientId is string &&
                       request.resource.data.recipientId.size() > 0;
      allow update: if true;
      allow delete: if true;
    }

    // 5. Reports collection (/reports/{reportId})
    // Anyone can submit abuse reports; reads and management restricted to admins
    match /reports/{reportId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.postId is string &&
                       request.resource.data.postId.size() > 0;
    }

    // 6. Feedback collection (/feedback/{feedbackId})
    // Anyone can submit suggestions/feedback; reads and management restricted to admins
    match /feedback/{feedbackId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.message is string &&
                       request.resource.data.message.size() > 0;
    }

    // 7. Category updates collection (/category_updates/{docId})
    // Public read for remote category quotes sync; writes restricted to admins
    match /category_updates/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 8. Remote app configuration collection (/app_config/{configId})
    // Public read so all app users (including guests) can fetch dynamic settings (ads configuration, feature flags)
    // Writes restricted to verified administrators
    match /app_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 9. Dedicated Administrators collection (/admins/{adminId})
    // Allow read if authenticated user; allow write (create, update, delete) if isAdmin()
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 10. Remote app announcements collection (/app_announcements/{announcementId})
    // Public read so all app users can receive broadcast announcements; writes restricted to admins
    match /app_announcements/{announcementId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default Deny for any unlisted collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
