<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_surface"
    android:orientation="vertical"
    android:padding="16dp"
    android:layoutDirection="rtl">

    <!-- مقبض السحب العلوي -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_sheet_handle"
        android:alpha="0.5" />

    <!-- الرأس: الأيقونة والعنوان والمحاولات -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp">

        <FrameLayout
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_category_well"
            android:padding="8dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sparkle_ai"
                app:tint="#38BDF8" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/ai_writer_title"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvQuotaBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/ai_quota_badge"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnAiKeyConfig"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_key"
            app:tint="@color/text_secondary" />

        <ImageView
            android:id="@+id/btnCloseAiDialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close_small"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- اختيار الموضوع (Chips) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ai_topic_label"
        android:textColor="@color/text_secondary"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingHorizontal="2dp"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/layoutTopicChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipTopicWisdom"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_tool_chip_active"
                android:text="حكم وأمثال"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipTopicMotivation"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_tool_chip_idle"
                android:text="تحفيز ونجاح"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipTopicLove"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_tool_chip_idle"
                android:text="حب وغرام"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipTopicDua"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_tool_chip_idle"
                android:text="أدعية وأمل"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipTopicCalm"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_tool_chip_idle"
                android:text="خواطر هادئة"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipTopicFarewell"
                android:layout_width="wrap_content"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:background="@drawable/bg_tool_chip_idle"
                android:text="وداع وفراق"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- اختيار الأسلوب -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingHorizontal="2dp"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:id="@+id/layoutStyleChips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingEnd="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipStyleWisdom"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_tool_chip_active"
                android:text="حكمة بليغة"
                android:textColor="#FFFFFF"
                android:textSize="11.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipStyleShort"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_tool_chip_idle"
                android:text="خاطرة قصيرة"
                android:textColor="@color/text_primary"
                android:textSize="11.5sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipStylePoem"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_tool_chip_idle"
                android:text="شعر فخم"
                android:textColor="@color/text_primary"
                android:textSize="11.5sp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/chipStylePolish"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:background="@drawable/bg_tool_chip_idle"
                android:text="تحسين وبلاغة"
                android:textColor="@color/text_primary"
                android:textSize="11.5sp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- إدخال فكرة مخصصة (اختياري) -->
    <EditText
        android:id="@+id/etCustomPrompt"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_search_bar"
        android:hint="@string/ai_custom_prompt_hint"
        android:paddingHorizontal="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="13sp"
        android:layout_marginBottom="14dp"
        android:singleLine="true" />

    <!-- زر التوليد السحري -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGenerateAi"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:backgroundTint="#0284C7"
        android:text="@string/ai_generate_btn"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_sparkle_ai"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="#FFFFFF"
        android:layout_marginBottom="16dp" />

    <!-- صندوق النتيجة -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardAiResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="18dp"
        app:cardElevation="3dp"
        app:cardBackgroundColor="@color/bg_card"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvGeneratedQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="كن كالنخيل عن الأحقاد مرتفعاً، يرمى بصخر فيلقي أطيب الثمر." />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="@color/divider_color" />

            <!-- أزرار الإجراءات السريعة في صف متناسق -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- نسخ -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAiActionCopy"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/ai_copy_btn"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:strokeColor="#3338BDF8"
                    app:strokeWidth="1dp"
                    app:icon="@drawable/ic_copy"
                    app:iconTint="#38BDF8"
                    app:iconSize="13dp" />

                <!-- تصميم صورة -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAiActionImage"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.2"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/ai_image_btn"
                    android:textColor="#34D399"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:strokeColor="#3334D399"
                    app:strokeWidth="1dp"
                    app:icon="@drawable/ic_share_image"
                    app:iconTint="#34D399"
                    app:iconSize="13dp" />

                <!-- تصميم فيديو -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAiActionVideo"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1.2"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/ai_video_btn"
                    android:textColor="#F472B6"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:strokeColor="#33F472B6"
                    app:strokeWidth="1dp"
                    app:icon="@drawable/ic_video_reel"
                    app:iconTint="#F472B6"
                    app:iconSize="13dp" />

                <!-- استخدام/نشر -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAiActionPublish"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="@string/ai_publish_btn"
                    android:textColor="#FBBF24"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp"
                    app:strokeColor="#33FBBF24"
                    app:strokeWidth="1dp"
                    app:icon="@drawable/ic_plus"
                    app:iconTint="#FBBF24"
                    app:iconSize="13dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
