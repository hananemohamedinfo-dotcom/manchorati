<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- 1. Fullscreen Video Motion Canvas -->
    <com.manchorati.www.VideoMotionView
        android:id="@+id/reelMotionView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- 2. Bottom Dark Gradient Protection Overlay (Extended for full legibility) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_reel_bottom_gradient" />

    <!-- 3. Play/Pause Feedback Indicator -->
    <ImageView
        android:id="@+id/ivReelPlayIndicator"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_reel_glass_button"
        android:padding="18dp"
        android:src="@drawable/ic_video_play"
        android:visibility="gone"
        app:tint="#FFFFFF" />

    <!-- 4. Double Tap Pop-up Heart -->
    <ImageView
        android:id="@+id/ivReelDoubleTapHeart"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="center"
        android:src="@drawable/ic_heart_filled"
        android:visibility="gone"
        app:tint="#EF4444" />

    <!-- 5. Modern Glassmorphic Top Bar (Cleanly offset below device status bar) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_gravity="top"
        android:layout_marginTop="32dp"
        android:paddingHorizontal="16dp">

        <!-- Close Button (Frosted Circle) -->
        <FrameLayout
            android:id="@+id/btnReelClose"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_reel_glass_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_close_small"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Top Studio Edit Button (Sleek Glass Pill) -->
        <LinearLayout
            android:id="@+id/btnReelEditInStudio"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_reel_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_edit"
                app:tint="#38BDF8" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="تعديل الفيديو ✏️"
                android:textColor="#F1F5F9"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- 6. Bottom Author & Caption Overlay (Left-aligned, clear of right actions & bottom nav) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|left"
        android:layout_marginBottom="62dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="76dp"
        android:orientation="vertical">

        <!-- Author Header (Avatar + Name + Badge) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivReelAuthorAvatar"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_reel_glass_button"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvReelAuthorName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:maxWidth="160dp"
                        android:text="اسم الكاتب"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvReelAuthorBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="👑"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvReelAuthorUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@username"
                    android:textColor="#CBD5E1"
                    android:textSize="11.5sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Quote Content Text Preview -->
        <TextView
            android:id="@+id/tvReelContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="2"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4"
            android:text="نص الاقتباس هنا..."
            android:textColor="#F8FAFC"
            android:textSize="13sp" />

        <!-- Tag & Audio Pills Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvReelTag"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:background="@drawable/bg_reel_pill"
                android:gravity="center"
                android:paddingHorizontal="9dp"
                android:text="#خاطرة"
                android:textColor="#38BDF8"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/layoutReelAudioPill"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_reel_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="9dp">

                <ImageView
                    android:layout_width="11dp"
                    android:layout_height="11dp"
                    android:layout_marginEnd="5dp"
                    android:src="@drawable/ic_capcut_audio"
                    app:tint="#F1F5F9" />

                <TextView
                    android:id="@+id/tvReelAudioTrack"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="موسيقى تصويرية"
                    android:textColor="#F1F5F9"
                    android:textSize="10.5sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 7. Right-Side Floating Glassmorphic Action Bar (Always on right edge) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|right"
        android:layout_marginBottom="62dp"
        android:layout_marginRight="14dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- 1. Like Action -->
        <FrameLayout
            android:id="@+id/btnReelLike"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_reel_glass_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivReelLike"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_heart_outline"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvReelLikesCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="0"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- 2. WhatsApp Status Quick Action -->
        <FrameLayout
            android:id="@+id/btnReelWhatsApp"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_reel_glass_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_whatsapp"
                app:tint="#25D366" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="واتساب"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- 3. Export Video MP4 Button -->
        <FrameLayout
            android:id="@+id/btnReelExportMp4"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_reel_glass_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_download"
                app:tint="#38BDF8" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="12dp"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="تحميل"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- 4. General Share Button -->
        <FrameLayout
            android:id="@+id/btnReelShareGeneral"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_reel_glass_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="21dp"
                android:layout_height="21dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_share_card"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="مشاركة"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</FrameLayout>
