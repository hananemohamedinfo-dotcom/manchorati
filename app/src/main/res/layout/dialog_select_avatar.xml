<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_main"
    android:layoutDirection="locale"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- عنوان النافذة -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:text="@string/select_avatar_title"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- مساحة قابلة للتمرير لعرض كافة الأفاتارات -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="vertical"
        android:fadeScrollbars="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. قسم حساب جوجل / الصورة الشخصية الأصلية -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="الصورة الأصلية للحساب"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivGooglePhoto"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_profile" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="استخدام صورة حساب جوجل"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- 2. قسم رمزيات شباب (10) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:text="👨‍💼 رمزيات شباب (10)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="5"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/ivAvatar5"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_5" />

                <ImageView
                    android:id="@+id/ivAvatar6"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_6" />

                <ImageView
                    android:id="@+id/ivAvatar7"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_7" />

                <ImageView
                    android:id="@+id/ivAvatar8"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_8" />

                <ImageView
                    android:id="@+id/ivAvatar9"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_9" />

                <ImageView
                    android:id="@+id/ivAvatar11"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_11" />

                <ImageView
                    android:id="@+id/ivAvatar12"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_12" />

                <ImageView
                    android:id="@+id/ivAvatar14"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_14" />

                <ImageView
                    android:id="@+id/ivAvatar19"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_19" />

                <ImageView
                    android:id="@+id/ivAvatar20"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_20" />
            </GridLayout>

            <!-- 3. قسم رمزيات بنات (10) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="10dp"
                android:text="🌸 رمزيات بنات (10)"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:alignmentMode="alignMargins"
                android:columnCount="5"
                android:gravity="center"
                android:layout_marginBottom="12dp">

                <ImageView
                    android:id="@+id/ivAvatar1"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_1" />

                <ImageView
                    android:id="@+id/ivAvatar2"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_2" />

                <ImageView
                    android:id="@+id/ivAvatar3"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_3" />

                <ImageView
                    android:id="@+id/ivAvatar4"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_4" />

                <ImageView
                    android:id="@+id/ivAvatar10"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_10" />

                <ImageView
                    android:id="@+id/ivAvatar13"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_13" />

                <ImageView
                    android:id="@+id/ivAvatar15"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_15" />

                <ImageView
                    android:id="@+id/ivAvatar16"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_16" />

                <ImageView
                    android:id="@+id/ivAvatar17"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_17" />

                <ImageView
                    android:id="@+id/ivAvatar18"
                    android:layout_width="54dp"
                    android:layout_height="54dp"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/avatar_18" />
            </GridLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
