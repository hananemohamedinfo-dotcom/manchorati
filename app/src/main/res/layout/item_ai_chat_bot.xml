<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="14dp"
    android:layoutDirection="rtl"
    android:orientation="horizontal">

    <!-- أيقونة المساعد في دائرة صغيرة -->
    <FrameLayout
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_category_well"
        android:padding="6dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_sparkle_ai"
            app:tint="#38BDF8" />
    </FrameLayout>

    <!-- بطاقة الاقتباس الأدبي -->
    <androidx.cardview.widget.CardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/bg_card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- شريط العنوان والنموذج -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="مساعد منشوراتي الأدبي"
                    android:textColor="#38BDF8"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBotModelTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tool_chip_idle"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="Google Gemini"
                    android:textColor="@color/text_secondary"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- نص الاقتباس -->
            <TextView
                android:id="@+id/tvBotQuoteContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="7dp"
                android:textColor="@color/text_primary"
                android:textSize="15.5sp"
                android:textStyle="bold"
                android:textIsSelectable="true"
                tools:text="إذا اشتدت الظلمات واستحكمت حلقاتها، فاعلم أن فجر اليقين على أطراف الأفق يتهيأ للظهور، وما خاب عبد أحسن الظن بمن بيده ملكوت كل شيء." />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/divider_color" />

            <!-- أزرار الإجراءات المتناسقة -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- نسخ -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMsgCopy"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="نسخ"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    app:strokeColor="#3338BDF8"
                    app:strokeWidth="1dp"
                    app:icon="@drawable/ic_copy"
                    app:iconTint="#38BDF8"
                    app:iconSize="13dp" />

                <!-- تصميم صورة -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMsgImage"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1.2"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="تصميم صورة"
                    android:textColor="#34D399"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    app:strokeColor="#3334D399"
                    app:strokeWidth="1dp"
                    app:icon="@drawable/ic_share_image"
                    app:iconTint="#34D399"
                    app:iconSize="13dp" />

                <!-- فيديو AI -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMsgVideo"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1.1"
                    android:layout_marginEnd="4dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="فيديو AI"
                    android:textColor="#F472B6"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    app:strokeColor="#33F472B6"
                    app:strokeWidth="1dp"
                    app:icon="@drawable/ic_video_reel"
                    app:iconTint="#F472B6"
                    app:iconSize="13dp" />

                <!-- نشر / إدراج -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMsgPublish"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingHorizontal="4dp"
                    android:text="نشر"
                    android:textColor="#FBBF24"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    app:strokeColor="#33FBBF24"
                    app:strokeWidth="1dp"
                    app:icon="@drawable/ic_plus"
                    app:iconTint="#FBBF24"
                    app:iconSize="13dp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
