<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutCommentRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="locale"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="5dp">

    <!-- مساحة الإزاحة عند الردود المتفرعة (Facebook-style indent) -->
    <View
        android:id="@+id/viewReplyIndent"
        android:layout_width="32dp"
        android:layout_height="1dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- أيقونة المستخدم -->
    <FrameLayout
        android:id="@+id/layoutUserAvatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="2dp"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:id="@+id/ivCommentAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile" />
    </FrameLayout>

    <!-- مساحة محتوى التعليق وفقاعة الفيسبوك -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:layoutDirection="locale"
        android:orientation="vertical">

        <!-- فقاعة التعليق (Facebook Bubble) -->
        <LinearLayout
            android:id="@+id/layoutCommentBubble"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_comment_bubble"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <!-- سطر اسم المستخدم -->
            <TextView
                android:id="@+id/tvCommentAuthor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="right|center_vertical"
                android:textAlignment="viewStart"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="اسم المستخدم" />

            <!-- إشارة الرد على مستخدم آخر -->
            <LinearLayout
                android:id="@+id/layoutReplyHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reply_prefix"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvReplyToAuthor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#0284C7"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="@أحمد" />
            </LinearLayout>

            <!-- نص التعليق -->
            <TextView
                android:id="@+id/tvCommentContent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="right"
                android:textAlignment="viewStart"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                tools:text="نص التعليق الجميل يظهر هنا داخل فقاعة احترافية..." />
        </LinearLayout>

        <!-- سطر الإجراءات أسفل الفقاعة: الوقت • معدل • رد • تعديل • حذف -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCommentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                tools:text="منذ 5 د" />

            <!-- علامة (معدّل) -->
            <TextView
                android:id="@+id/tvEditedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/edited_badge"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="5dp"
                android:text="•"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <!-- زر الرد -->
            <TextView
                android:id="@+id/btnReplyComment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:text="@string/reply_button"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- نقطة فاصلة لزر التعديل -->
            <TextView
                android:id="@+id/tvEditSeparator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="5dp"
                android:text="•"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- زر التعديل -->
            <TextView
                android:id="@+id/btnEditComment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:text="@string/edit_button"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- نقطة فاصلة لزر الحذف -->
            <TextView
                android:id="@+id/tvDeleteSeparator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="5dp"
                android:text="•"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- زر الحذف نصي أنيق مثل فيسبوك -->
            <TextView
                android:id="@+id/btnDeleteComment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:text="@string/delete_button"
                android:textColor="#EF4444"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
