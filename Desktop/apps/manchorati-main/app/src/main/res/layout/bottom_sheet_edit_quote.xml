<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#15171C"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_sheet_handle" />

    <!-- Header Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="6dp">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_marginEnd="10dp"
            android:src="@drawable/ic_edit"
            app:tint="#38BDF8" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/studio_edit_quote_title"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/studio_edit_quote_subtitle"
        android:textColor="#94A3B8"
        android:textSize="12.5sp" />

    <!-- Text Input Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_segment_container"
        android:backgroundTint="#1A202C"
        android:orientation="vertical"
        android:padding="12dp">

        <EditText
            android:id="@+id/etEditQuoteContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:gravity="top|start"
            android:hint="@string/studio_edit_quote_hint"
            android:lineSpacingExtra="4dp"
            android:maxLines="8"
            android:minLines="4"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvEditCharCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:text="0 حرف"
            android:textColor="#64748B"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Action Buttons Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCancelEditQuote"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_segment_container"
            android:backgroundTint="#26FFFFFF"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/no"
            android:textColor="#94A3B8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSaveEditQuote"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.6"
            android:background="@drawable/bg_button_gradient_primary"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="@string/studio_save_apply"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
