<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080C14"
    android:orientation="vertical">

    <!-- 1. Top Sleek Studio Toolbar -->
    <LinearLayout
        android:id="@+id/layoutStudioHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D131F"
        android:orientation="vertical">

        <!-- Status Bar Spacer (height set programmatically) -->
        <View
            android:id="@+id/statusBarSpacer"
            android:layout_width="match_parent"
            android:layout_height="0dp" />

        <!-- Actual Header Content (56dp) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:paddingHorizontal="14dp">

            <!-- Back Button -->
            <FrameLayout
                android:id="@+id/btnBackContainer"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_send_comment_circle"
                android:backgroundTint="#1AFFFFFF"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="#FFFFFF" />
            </FrameLayout>

            <!-- Center Title -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="استوديو الفيديو 🎬"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="صانع الريلز والستوري المتحرك"
                    android:textColor="#64748B"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- Ratio Toggle Pills -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_segment_container"
                android:backgroundTint="#1AFFFFFF"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/btnRatioStory"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_segment_btn_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="9dp"
                    android:text="9:16"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnRatioSquare"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="9dp"
                    android:text="1:1"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <!-- 2. Scrollable Studio Body -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- 2.1 Floating Phone Mockup Canvas Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPreviewMockup"
                android:layout_width="wrap_content"
                android:layout_height="340dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                app:cardBackgroundColor="#050811"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:strokeColor="#253552"
                app:strokeWidth="1.5dp"
                app:cardPreventCornerOverlap="true">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent">

                    <com.manchorati.www.VideoMotionView
                        android:id="@+id/videoMotionView"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="center" />

                    <!-- Quick Fade Feedback Icon when tapping play/pause -->
                    <ImageView
                        android:id="@+id/ivPlayPauseIndicator"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_send_comment_circle"
                        android:backgroundTint="#80000000"
                        android:padding="16dp"
                        android:src="@drawable/ic_video_play"
                        android:visibility="gone"
                        app:tint="#FFFFFF" />

                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2.2 Duration Selector Row (Cleanly outside video canvas!) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_segment_container"
                android:backgroundTint="#1AFFFFFF"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/btnDur5s"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="5 ثواني"
                    android:textColor="#94A3B8"
                    android:textSize="10.5sp" />

                <TextView
                    android:id="@+id/btnDur10s"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_segment_btn_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="10 ثواني"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnDur15s"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@null"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="10dp"
                    android:text="15 ثانية"
                    android:textColor="#94A3B8"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <!-- 2.3 Privacy Warning Pill for Custom Media -->
            <LinearLayout
                android:id="@+id/layoutCustomMediaWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_white"
                android:backgroundTint="#1F991B1B"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="محتوى مخصص: متاح للتصدير والمشاركة على واتساب وتطبيقات التواصل فقط (لحفظ الخصوصية وحقوق الملكية)."
                    android:textColor="#FCA5A5"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- 2.4 Modern Category Tab Strip (Dock Style) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_segment_container"
                android:backgroundTint="#14FFFFFF"
                android:orientation="horizontal"
                android:padding="2dp">

                <TextView
                    android:id="@+id/tabMotion"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_segment_btn_active"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🎨 الخلفية"
                    android:textColor="#FFFFFF"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tabAudio"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🎵 الصوت"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tabAnim"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="✨ الحركة"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp" />

                <TextView
                    android:id="@+id/tabFont"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@null"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="✍️ الخط"
                    android:textColor="#94A3B8"
                    android:textSize="11.5sp" />
            </LinearLayout>

            <!-- 2.5 Carousel for Tab 1: Motion Backgrounds -->
            <HorizontalScrollView
                android:id="@+id/scrollMotion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutMotionPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- 2.6 Carousel for Tab 2: Audio Presets -->
            <HorizontalScrollView
                android:id="@+id/scrollAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layoutAudioPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- 2.7 Carousel for Tab 3: Animation Styles -->
            <HorizontalScrollView
                android:id="@+id/scrollAnim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layoutAnimStyles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- 2.8 Carousel for Tab 4: Arabic Fonts -->
            <HorizontalScrollView
                android:id="@+id/scrollFont"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clipToPadding="false"
                android:paddingHorizontal="20dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layoutFontPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

        </LinearLayout>
    </ScrollView>

    <!-- 3. Bottom Sticky Action Dock (Padded safely above navigation bar!) -->
    <LinearLayout
        android:id="@+id/layoutBottomDock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#0D131F"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <!-- Top Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal">

            <!-- Share to WhatsApp Status -->
            <LinearLayout
                android:id="@+id/btnShareWhatsApp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_gradient_primary"
                android:backgroundTint="#059669"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_whatsapp"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="حالة واتساب 🟢"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Save MP4 to Gallery -->
            <LinearLayout
                android:id="@+id/btnSaveGallery"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_button_gradient_primary"
                android:backgroundTint="#1E293B"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@drawable/ic_download"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="حفظ الفيديو 💾"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- General Share -->
            <FrameLayout
                android:id="@+id/btnShareGeneral"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_button_gradient_primary"
                android:backgroundTint="#0284C7"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_share_card"
                    app:tint="#FFFFFF" />
            </FrameLayout>
        </LinearLayout>

        <!-- Bottom Row: Publish to Community (Virtual Video) -->
        <LinearLayout
            android:id="@+id/btnPublishCommunity"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_gradient_primary"
            android:backgroundTint="#EF4444"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_video_reel"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="نشر كفيديو في مجتمع منشوراتي 🌐"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
