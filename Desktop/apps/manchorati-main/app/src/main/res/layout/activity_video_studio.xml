<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A"
    android:orientation="vertical">

    <!-- Status Bar Spacer (height set programmatically) -->
    <View
        android:id="@+id/statusBarSpacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#0A0A0A" />

    <!-- 1. CapCut Top Bar (52dp) -->
    <RelativeLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#0A0A0A"
        android:paddingHorizontal="16dp">

        <!-- Back Button '<' -->
        <FrameLayout
            android:id="@+id/btnBackContainer"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_arrow_back"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Center Studio Title -->
        <TextView
            android:id="@+id/tvTopTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="استوديو الفيديو"
            android:textColor="#E2E8F0"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Top Right "Enreg." / Save Button (Exact CapCut style) -->
        <FrameLayout
            android:id="@+id/btnEnregContainer"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="8dp">

            <TextView
                android:id="@+id/btnEnreg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Enreg."
                android:textColor="#FFFFFF"
                android:textSize="15.5sp"
                android:textStyle="bold" />
        </FrameLayout>
    </RelativeLayout>

    <!-- 2. Video Preview Area (Fills space above controls) -->
    <FrameLayout
        android:id="@+id/layoutPreviewArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#000000">

        <!-- Video Motion View -->
        <com.manchorati.www.VideoMotionView
            android:id="@+id/videoMotionView"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Quick Fade Feedback Icon when tapping play/pause -->
        <ImageView
            android:id="@+id/ivPlayPauseIndicator"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_send_comment_circle"
            android:backgroundTint="#80000000"
            android:padding="16dp"
            android:src="@drawable/ic_video_play"
            android:visibility="gone"
            app:tint="#FFFFFF" />
    </FrameLayout>

    <!-- 3. CapCut Playback Controls Bar (44dp: Time on Left, Play/Pause Center, Speaker Right) -->
    <RelativeLayout
        android:id="@+id/layoutPlaybackControls"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="#0A0A0A"
        android:paddingHorizontal="20dp">

        <!-- Time Display on the LEFT ("00:15" or "00:04 / 00:15") -->
        <TextView
            android:id="@+id/tvTimeCurrent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            android:text="00:15"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Play / Pause Button in the CENTER -->
        <ImageView
            android:id="@+id/ivPlayPauseCenter"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_centerInParent="true"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_video_play"
            app:tint="#FFFFFF" />

        <!-- Mute / Speaker Icon on the RIGHT -->
        <ImageView
            android:id="@+id/ivMuteToggle"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_volume_up"
            app:tint="#FFFFFF" />
    </RelativeLayout>

    <!-- 4. CapCut Video Filmstrip Timeline (72dp with ruler ticks, frames, and center white playhead) -->
    <com.manchorati.www.TimelineFilmstripView
        android:id="@+id/timelineFilmstripView"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:background="#0A0A0A" />

    <!-- 5. Tool Panels Container (Slides up when a bottom tool is tapped) -->
    <LinearLayout
        android:id="@+id/layoutToolPanelContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#15171C"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Tool Panel Header (Active title + Checkmark Done button) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:background="#1E222B"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tvToolPanelTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="Audio"
                android:textColor="#38BDF8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCloseToolPanel"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:clickable="true"
                android:focusable="true"
                android:padding="4dp"
                android:src="@drawable/ic_check"
                app:tint="#38BDF8" />
        </RelativeLayout>

        <!-- Tool Panel Content Carousel -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="10dp">

            <!-- Panel 1: Audio -->
            <HorizontalScrollView
                android:id="@+id/scrollAudio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layoutAudioPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Panel 2: Effets (Animations) -->
            <HorizontalScrollView
                android:id="@+id/scrollAnim"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layoutAnimStyles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Panel 3: Ajouter Texte (Arabic Fonts) -->
            <HorizontalScrollView
                android:id="@+id/scrollFont"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layoutFontPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Panel 4: Autocollant (Toggles Author/Tag & Duration & Ratio) -->
            <HorizontalScrollView
                android:id="@+id/scrollOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layoutOptionsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Duration Selector: 15s, 30s, 45s -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_segment_container"
                        android:backgroundTint="#26FFFFFF"
                        android:orientation="horizontal"
                        android:padding="2dp">

                        <TextView
                            android:id="@+id/btnDur15s"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_segment_btn_active"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:text="15s"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnDur30s"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:text="30s"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/btnDur45s"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="12dp"
                            android:text="45s"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Ratio Toggle: 9:16 vs 1:1 -->
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/bg_segment_container"
                        android:backgroundTint="#26FFFFFF"
                        android:orientation="horizontal"
                        android:padding="2dp">

                        <TextView
                            android:id="@+id/btnRatioStory"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_segment_btn_active"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="9:16"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnRatioSquare"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center"
                            android:paddingHorizontal="10dp"
                            android:text="1:1"
                            android:textColor="#94A3B8"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <!-- Author Toggle -->
                    <TextView
                        android:id="@+id/btnToggleAuthor"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_segment_btn_active"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="👤 اسم الكاتب"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <!-- Tag Toggle -->
                    <TextView
                        android:id="@+id/btnToggleTag"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_segment_container"
                        android:backgroundTint="#26FFFFFF"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingHorizontal="12dp"
                        android:text="🏷️ الوسم"
                        android:textColor="#94A3B8"
                        android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Panel 5: Aj. Photo (Backgrounds) -->
            <HorizontalScrollView
                android:id="@+id/scrollMotion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:paddingHorizontal="16dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layoutMotionPresets"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

        </FrameLayout>
    </LinearLayout>

    <!-- 6. CapCut Bottom Toolbar (Exact Match to User Screenshot) -->
    <LinearLayout
        android:id="@+id/layoutBottomToolbar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="#121212"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Tool 1: Audio -->
        <LinearLayout
            android:id="@+id/toolAudio"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_capcut_audio"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Audio"
                android:textColor="#E2E8F0"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Tool 2: Effets -->
        <LinearLayout
            android:id="@+id/toolEffects"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_capcut_effects"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Effets"
                android:textColor="#E2E8F0"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Tool 3: Ajouter Texte -->
        <LinearLayout
            android:id="@+id/toolText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.2"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_capcut_text"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Ajouter Texte"
                android:textColor="#E2E8F0"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Tool 4: Autocollant -->
        <LinearLayout
            android:id="@+id/toolStickers"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_capcut_sticker"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Autocollant"
                android:textColor="#E2E8F0"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- Tool 5: Aj. Photo -->
        <LinearLayout
            android:id="@+id/toolPhoto"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_capcut_photo"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Aj. Photo"
                android:textColor="#E2E8F0"
                android:textSize="10.5sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Navigation Bar Spacer -->
    <View
        android:id="@+id/navBarSpacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#121212" />

</LinearLayout>
