<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_main"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- شريط علوي -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:text="محرر وتصميم البطاقة"
                android:textColor="@color/text_primary"
                android:textSize="17sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnCloseDialog"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="@color/text_secondary"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </RelativeLayout>

        <!-- مساحة معاينة البطاقة (تبقى بألوان ثابتة لضمان ثبات التصميم عند الحفظ) -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardPreviewContainer"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#0F172A">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- صورة الخلفية المخصصة من الهاتف -->
                <ImageView
                    android:id="@+id/ivCustomBackground"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <!-- طبقة تعتيم خفيفة لإبراز النص -->
                <View
                    android:id="@+id/viewOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#66000000"
                    android:visibility="gone" />

                <!-- محتوى البطاقة -->
                <RelativeLayout
                    android:id="@+id/layoutCardContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvPreviewCategory"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentTop="true"
                        android:layout_centerHorizontal="true"
                        android:text="• حكم وأقوال •"
                        android:textColor="#38BDF8"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvPreviewContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:text="نص المنشور يظهر هنا"
                        android:textColor="#F8FAFC"
                        android:textSize="18sp"
                        android:lineSpacingExtra="6dp"
                        android:shadowColor="#80000000"
                        android:shadowDx="1.5"
                        android:shadowDy="1.5"
                        android:shadowRadius="3" />

                    <TextView
                        android:id="@+id/tvPreviewWatermark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:text="منشوراتي "
                        android:textColor="#94A3B8"
                        android:textSize="12sp" />
                </RelativeLayout>
            </FrameLayout>
        </androidx.cardview.widget.CardView>

        <!-- خيار اختيار صورة من الهاتف -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPickImage"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:text="📷 اختيار صورة من الهاتف"
                android:textSize="12sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0284C7" />

            <Button
                android:id="@+id/btnRemoveImage"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="إزالة الصورة"
                android:textSize="12sp"
                android:textColor="#EF4444"
                android:backgroundTint="@color/search_bg"
                android:visibility="gone" />
        </LinearLayout>

        <!-- زر اختيار الخط عبر النافذة المنبثقة -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:text="نمط الخط العربي:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnOpenFontPicker"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="🔤 اختر نوع الخط من القائمة"
            android:textSize="13sp"
            android:textColor="@color/text_primary"
            android:backgroundTint="@color/search_bg" />

        <!-- ألوان الخلفية السادة (تبقى ثابتة لأنها لوحة ألوان) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="6dp"
            android:text="ألوان الخلفية السادة:"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

<LinearLayout
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
<!-- 
            <View android:id="@+id/btnColorDark" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="8dp" android:background="#0F172A" />
            <View android:id="@+id/btnColorBlue" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="8dp" android:background="#1E3A8A" />
            <View android:id="@+id/btnColorGreen" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="8dp" android:background="#064E3B" />
            <View android:id="@+id/btnColorPurple" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="8dp" android:background="#581C87" />
            <View android:id="@+id/btnColorDarkRed" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="8dp" android:background="#7F1D1D" />
            <View android:id="@+id/btnColorLight" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="8dp" android:background="#F1F5F9" />
             -->
            <!-- الزر الجديد الخاص بعجلة ألوان الخلفية -->
            <ImageButton
                android:id="@+id/btnBgColorCustom"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_search_bar" 
                android:src="@drawable/ic_color_picker" 
                android:scaleType="centerInside"
                android:padding="4dp" />
        </LinearLayout>

        <!-- لون النص والتحكم بالحجم -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="لون النص:"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

             <!-- <View android:id="@+id/btnTextColorWhite" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="8dp" android:background="#FFFFFF" />
            <View android:id="@+id/btnTextColorYellow" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="6dp" android:background="#FACC15" />
            <View android:id="@+id/btnTextColorBlack" android:layout_width="24dp" android:layout_height="24dp" android:layout_marginStart="6dp" android:background="#0F172A" /> -->

            <!-- الزر الجديد الخاص بعجلة الألوان -->
            <ImageButton
                android:id="@+id/btnTextColorCustom"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_search_bar" 
                android:src="@drawable/ic_color_picker" 
                android:scaleType="centerInside"
                android:padding="4dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- زر تكبير الخط -->
            <TextView
                android:id="@+id/btnPreviewBigger"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:gravity="center"
                android:text="A +"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_search_bar" />

            <!-- زر تصغير الخط -->
            <TextView
                android:id="@+id/btnPreviewSmaller"
                android:layout_width="40dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:text="A -"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_search_bar" />
        </LinearLayout>

        <!-- أزرار الإجراءات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelPreview"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="إلغاء"
                android:textColor="@color/text_primary"
                android:backgroundTint="@color/search_bg" />

            <Button
                android:id="@+id/btnSaveImage"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.2"
                android:layout_marginEnd="4dp"
                android:text=" حفظ بالمعرض"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:backgroundTint="#10B981" />

            <Button
                android:id="@+id/btnConfirmShare"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1.3"
                android:text="مشاركة الصورة"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:backgroundTint="#0284C7" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>