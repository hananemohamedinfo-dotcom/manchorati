<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg_main"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- عنوان النافذة -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:text="اختر صورة الملف الشخصي"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- شبكة لعرض الصور (صورة جوجل + الـ 8 أفاتارات) -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:alignmentMode="alignMargins"
        android:columnCount="4"
        android:gravity="center">

        <!-- 1. صورة جوجل الشخصية -->
        <ImageView
            android:id="@+id/ivGooglePhoto"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile" />

        <!-- 2. الأفاتار الأول -->
        <ImageView
            android:id="@+id/ivAvatar1"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:src="@drawable/avatar_1" />

        <!-- 3. الأفاتار الثاني -->
        <ImageView
            android:id="@+id/ivAvatar2"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:src="@drawable/avatar_2" />

        <!-- 4. الأفاتار الثالث -->
        <ImageView
            android:id="@+id/ivAvatar3"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:src="@drawable/avatar_3" />

        <!-- 5. الأفاتار الرابع -->
        <ImageView
            android:id="@+id/ivAvatar4"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:src="@drawable/avatar_4" />

        <!-- 6. الأفاتار الخامس -->
        <ImageView
            android:id="@+id/ivAvatar5"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:src="@drawable/avatar_5" />

        <!-- 7. الأفاتار السادس -->
        <ImageView
            android:id="@+id/ivAvatar6"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:src="@drawable/avatar_6" />

        <!-- 8. الأفاتار السابع -->
        <ImageView
            android:id="@+id/ivAvatar7"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:src="@drawable/avatar_7" />

        <!-- 9. الأفاتار الثامن -->
        <ImageView
            android:id="@+id/ivAvatar8"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_margin="6dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:src="@drawable/avatar_8" />

    </GridLayout>

</LinearLayout>