<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutWidgetRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget_card"
    android:padding="13dp">

    <!-- الشريط العلوي للودجت -->
    <RelativeLayout
        android:id="@+id/layoutWidgetHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <!-- شعار منشوراتي واسم القسم -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_quotes" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/app_name"
                android:textColor="#38BDF8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWidgetTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_widget_tag"
                android:paddingHorizontal="7dp"
                android:paddingVertical="2dp"
                android:text="خاطرة اليوم"
                android:textColor="#BAE6FD"
                android:textSize="10.5sp" />
        </LinearLayout>

        <!-- أزرار التحكم السريعة (نسخ وتحديث) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- زر النسخ السريع -->
            <ImageView
                android:id="@+id/btnWidgetCopy"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_widget_button"
                android:padding="6dp"
                android:src="@drawable/ic_copy" />

            <!-- زر التحديث لخاطرة أخرى -->
            <ImageView
                android:id="@+id/btnWidgetRefresh"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_widget_button"
                android:padding="6dp"
                android:src="@drawable/ic_refresh" />
        </LinearLayout>
    </RelativeLayout>

    <!-- نص الخاطرة في المنتصف بتنسيق مريح للعين -->
    <TextView
        android:id="@+id/tvWidgetContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutWidgetHeader"
        android:gravity="center"
        android:lineSpacingExtra="3.5dp"
        android:paddingHorizontal="4dp"
        android:paddingVertical="6dp"
        android:text="ابتسم، فالحياة أجمل وأوسع عندما نراها بعين الرضا والبهجة 🌸"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

</RelativeLayout>
